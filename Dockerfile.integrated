FROM ros:jazzy-ros-base

ENV DEBIAN_FRONTEND=noninteractive \
    ROS_DISTRO=jazzy \
    PYTHONUNBUFFERED=1 \
    INTEGRATED_WS=/workspace/integrated_ws

SHELL ["/bin/bash", "-c"]

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-colcon-common-extensions \
    python3-opencv \
    python3-numpy \
    python3-serial \
    ros-jazzy-cv-bridge \
    ros-jazzy-tf2-ros \
    ros-jazzy-tf2-geometry-msgs \
    ros-jazzy-moveit \
    ros-jazzy-moveit-msgs \
    ros-jazzy-moveit-ros-move-group \
    ros-jazzy-moveit-simple-controller-manager \
    ros-jazzy-robot-state-publisher \
    ros-jazzy-ros2-control \
    ros-jazzy-ros2-controllers \
    ros-jazzy-xacro \
    iproute2 \
    net-tools \
    procps \
    && rm -rf /var/lib/apt/lists/*

WORKDIR ${INTEGRATED_WS}

COPY opencv/opencv_chengzhe-main/opencv_ros2_bridge_interfaces ${INTEGRATED_WS}/src/opencv_ros2_bridge_interfaces
COPY phantomx_pincher-ros2/phantomx_pincher ${INTEGRATED_WS}/src/phantomx_pincher
COPY phantomx_pincher-ros2/phantomx_pincher_description ${INTEGRATED_WS}/src/phantomx_pincher_description
COPY phantomx_pincher-ros2/phantomx_pincher_moveit_config ${INTEGRATED_WS}/src/phantomx_pincher_moveit_config

RUN source /opt/ros/jazzy/setup.bash \
    && colcon build --merge-install --symlink-install \
      --packages-select \
        opencv_ros2_bridge_interfaces \
        phantomx_pincher_description \
        phantomx_pincher_moveit_config \
        phantomx_pincher

COPY opencv/opencv_chengzhe-main /workspace/OpenCV_ROS
COPY ros /workspace/ros
COPY docker/integrated_entrypoint.sh /integrated_entrypoint.sh
COPY docker/run_integrated.bash /run_integrated.bash
COPY docker/integrated_move_group.launch.py /integrated_move_group.launch.py

RUN chmod +x /integrated_entrypoint.sh /run_integrated.bash \
    && chmod +x /integrated_move_group.launch.py \
    && chmod +x /workspace/OpenCV_ROS/run.bash \
    && chmod +x /workspace/ros/opencv_to_cm530_node.py \
    && chmod +x /workspace/ros/TEST07.py

ENTRYPOINT ["/integrated_entrypoint.sh"]
CMD ["bash", "/run_integrated.bash", "doctor"]
